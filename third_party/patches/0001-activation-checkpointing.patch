 from chunkformer.modules.convolution import ChunkConvolutionModule
@@ -306,17 +307,47 @@ class ChunkFormerEncoder(torch.nn.Module):
                     r_att_cache.append(new_att_cache)
                     r_cnn_cache.append(new_cnn_cache)
                     continue
-            xs, _, new_att_cache, new_cnn_cache = layer(
-                xs,
-                masks,
-                pos_emb,
-                mask_pad,
-                att_cache=att_cache[idx] if att_cache.size(0) > 0 else empty_att_cache,
-                cnn_cache=cnn_cache[idx] if cnn_cache.size(0) > 0 else empty_cnn_cache,
-                chunk_size=chunk_size,
-                left_context_size=left_context_size,
-                right_context_size=right_context_size,
-            )
+            cur_att_cache = att_cache[idx] if att_cache.size(0) > 0 else empty_att_cache
+            cur_cnn_cache = cnn_cache[idx] if cnn_cache.size(0) > 0 else empty_cnn_cache
+
+            if self.gradient_checkpointing and self.training and xs.requires_grad:
+                def make_custom_forward(mod):
+                    def custom_forward(x_in, m_in, p_in, mp_in, a_in, c_in):
+                        return mod(
+                            x_in,
+                            m_in,
+                            p_in,
+                            mp_in,
+                            att_cache=a_in,
+                            cnn_cache=c_in,
+                            chunk_size=chunk_size,
+                            left_context_size=left_context_size,
+                            right_context_size=right_context_size,
+                        )
+                    return custom_forward
+
+                xs, _, new_att_cache, new_cnn_cache = torch.utils.checkpoint.checkpoint(
+                    make_custom_forward(layer),
+                    xs,
+                    masks,
+                    pos_emb,
+                    mask_pad,
+                    cur_att_cache,
+                    cur_cnn_cache,
+                    use_reentrant=False,
+                )
+            else:
